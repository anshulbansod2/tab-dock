{
  "manifest_version": 3,
  "name": "Tab Dock",
  "version": "0.3.0",
  "description": "A horizontal quick-switch bar for the tabs in your current Chrome tab group.",
  "minimum_chrome_version": "123",
  "permissions": ["tabs", "tabGroups", "storage", "sessions", "scripting", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Dock",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Tab Dock"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": [
        "content/core.js",
        "content/format.js",
        "content/styles.js",
        "content/dom.js",
        "content/render.js",
        "content/events.js",
        "content/connection.js",
        "content/drag.js",
        "content/reorder.js",
        "content/menu.js",
        "content/dropzone.js",
        "content/preview.js",
        "content/view.js",
        "content/switcher.js",
        "content/bar.js",
        "content/main.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
